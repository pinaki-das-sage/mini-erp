APP_ENV=local
APP_MODE=standalone
# Blank auto-detects Apache's index.php directory; "/" forces site-root URLs.
APP_BASE_PATH=
# Absolute bearer-token lifetime; 60-86400 seconds, no automatic renewal.
API_TOKEN_TTL_SECONDS=3600
# Sales Invoice date defaults use this business timezone (not the server OS timezone).
APP_BUSINESS_TIMEZONE=Asia/Kolkata
# Browser tests run locally against this deployed application URL.
BROWSER_TEST_BASE_URL=
# Opt-in for trusted training servers only; skips browser/API certificate checks.
BROWSER_TEST_IGNORE_HTTPS_ERRORS=false
# Optional login test: set all three privately, or leave all blank.
BROWSER_TEST_COMPANY=
BROWSER_TEST_USERNAME=
BROWSER_TEST_PASSWORD=
# Local browser-test mount only; independent of the deployed application's URL.
BROWSER_TEST_BASE_PATH=/mini-erp/public/
BOOTSTRAP_ADMIN_USER=admin
# Optional override; blank uses admin/admin for the internal lab bootstrap.
BOOTSTRAP_ADMIN_PASSWORD=
# Optional private INI file. Default: config.ini in the project root.
ORACLE_CONFIG_FILE=
# These optional values override config.ini.
ORACLE_DB_HOST=
ORACLE_DB_PORT=
ORACLE_DB_SERVICE=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
# Explicitly enable only for a dedicated disposable test schema.
LAB_ORACLE_TEST=0
ORACLE_TEST_SCHEMA=
