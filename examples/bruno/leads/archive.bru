meta {
  name: Archive selected lead
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/sales/leads/{{target_lead_id}}/archive
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "expected_version": {{?Current lead version}},
    "action_reference": "{{?Action reference (reuse unchanged for retry)}}"
  }
}

script:pre-request {
  if (!/^[a-f0-9]{64}$/.test(bru.getVar("access_token") || "")) {
    throw new Error("Run Login with Leads archive permission first.");
  }
  const id = bru.getVar("target_lead_id") ?? bru.getEnvVar("target_lead_id");
  if (typeof id !== "string" || !/^[a-f0-9]{32}$/.test(id)) {
    throw new Error("Create a test lead or explicitly set target_lead_id from List leads.");
  }
}

tests {
  test("Archives the selected lead", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(Number.isInteger(res.getBody().result.current_version)).to.equal(true);
  });
}

docs {
  Requires sales.leads:archive. This hides the lead from active lists; it does not delete it.
  Confirm target_lead_id and its current version. Use only approved synthetic test data.
  Retry an uncertain result with the same version, reference and body; never create a fresh reference blindly.
}
