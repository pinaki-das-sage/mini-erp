meta {
  name: Reset test user password
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/users/{{target_user_id}}/reset-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "password": "{{?New temporary password (12-72 bytes)}}",
    "expected_version": {{?Current user version}}
  }
}

script:pre-request {
  const token = bru.getVar("access_token");
  if (typeof token !== "string" || !/^[a-f0-9]{64}$/.test(token)) {
    throw new Error("Run Login as an administrator first.");
  }
  const id = bru.getVar("target_user_id") ?? bru.getEnvVar("target_user_id");
  if (typeof id !== "string" || !/^[a-zA-Z0-9_-]{1,40}$/.test(id)) {
    throw new Error("Create a test user or explicitly set target_user_id from List users.");
  }
}

tests {
  test("Admin resets the selected test user's password", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.success).to.equal(true);
    expect(Boolean(body.result && Number.isInteger(body.result.current_version))).to.equal(true);
  });
}

docs {
  Confirm the selected test user and latest current_version before sending.
  New password is prompted, not persisted in the collection.
  This invalidates the user's tokens and requires password change at the next login.
}
